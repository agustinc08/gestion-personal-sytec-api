generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum LicenseStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LicenseFieldType {
  TEXT
  DATE
  NUMBER
  MULTILINE
}

enum ProjectStatus {
  ACTIVE
  PENDING
  IN_PROGRESS
  COMPLETED
  FINISHED
  PAUSED
  IN_REVIEW
  READY_FOR_GIT
  IN_DEV_BRANCH
  READY_FOR_DOCKER
  DOCKERIZED
  DEPLOYED
  NEEDS_REWORK
  NEEDS_REDESIGN
  ARCHIVED
}

enum ProjectDifficulty {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DeployEnvironment {
  LOCAL
  DEV
  TEST
  PROD
}

enum DeployStatus {
  PENDING
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum ActivityType {
  PROJECT
  SUPPORT
  MAINTENANCE
  DEPLOY
  MEETING
  DOCUMENTATION
  OTHER
}

enum WorkLogMode {
  ONSITE
  REMOTE
  MIXED
  LICENSE
}

enum WorkLogStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum AnnouncementType {
  GENERAL
  STRIKE
  SALARY
  LICENSE
  PROJECT
  SYSTEM
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id                 String           @id @default(cuid())
  cuil               String           @unique
  email              String?          @unique
  passwordHash       String
  role               Role             @default(EMPLOYEE)
  mustChangePassword Boolean          @default(true)
  employeeId         String?          @unique
  legacyId           String?          @unique
  employee           Employee?        @relation(fields: [employeeId], references: [id])
  auditLogs          AuditLog[]
  deployments        Deployment[]
  notifications      Notification[]
  projectComments    ProjectComment[]
  createdAnnouncements Announcement[] @relation("AnnouncementCreator")
  announcementReads  AnnouncementRead[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  @@index([role])
}

model Employee {
  id               String           @id @default(cuid())
  legacyId         String?          @unique
  name             String
  email            String?          @unique
  avatar           String?
  dependency       String
  dependencyId     String?
  dependencyRef    Dependency?      @relation(fields: [dependencyId], references: [id], onDelete: SetNull)
  position         String?
  cuil             String           @unique
  totalLicenseDays Int              @default(0)
  compensatoryDays Int              @default(0)
  strikeDutyOrder  Int              @default(-1)
  user             User?
  remoteDays       RemoteDay[]
  workLogs         WorkLog[]
  licenseRequests  LicenseRequest[]
  assignedProjects Project[]        @relation("ProjectAssignees")
  ownedProjects    Project[]        @relation("ProjectOwner")
  authoredUpdates  ProjectUpdate[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  targetedAnnouncements Announcement[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([dependency])
  @@index([dependencyId])
  @@index([strikeDutyOrder])
}

model Dependency {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)
  employees   Employee[]
  announcements Announcement[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([isActive, deletedAt])
}

model Announcement {
  id                 String               @id @default(cuid())
  title              String
  message            String
  type               AnnouncementType     @default(GENERAL)
  priority           AnnouncementPriority @default(NORMAL)
  targetRole         Role?
  targetDependencyId String?
  targetEmployeeId   String?
  startsAt           DateTime?
  endsAt             DateTime?
  pinned             Boolean              @default(false)
  isActive            Boolean              @default(true)
  createdByUserId    String
  createdBy          User                 @relation("AnnouncementCreator", fields: [createdByUserId], references: [id])
  targetDependency   Dependency?          @relation(fields: [targetDependencyId], references: [id], onDelete: SetNull)
  targetEmployee     Employee?            @relation(fields: [targetEmployeeId], references: [id], onDelete: SetNull)
  reads              AnnouncementRead[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  @@index([isActive, startsAt, endsAt])
  @@index([targetRole])
  @@index([targetDependencyId])
  @@index([targetEmployeeId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

model Project {
  id                  String            @id @default(cuid())
  legacyId            String?           @unique
  name                String
  description         String
  requesterDependency String
  status              ProjectStatus     @default(ACTIVE)
  year                Int               @default(2026)
  difficulty          ProjectDifficulty @default(MEDIUM)
  deadline            DateTime?
  ownerId             String?
  repositoryApiUrl    String?
  repositoryWebUrl    String?
  branch              String?
  techStack           String?
  notes               String?
  needsRedesign       Boolean           @default(false)
  needsRework         Boolean           @default(false)
  owner               Employee?         @relation("ProjectOwner", fields: [ownerId], references: [id])
  assignedEmployees   Employee[]        @relation("ProjectAssignees")
  updates             ProjectUpdate[]
  workLogs            WorkLog[]
  deployments         Deployment[]
  comments            ProjectComment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  @@index([status])
  @@index([year])
  @@index([difficulty])
  @@index([deadline])
  @@index([ownerId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  employeeId String?
  roleTarget Role?
  type       String
  title      String
  message    String
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  metadata   Json?
  dedupeKey  String    @unique
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([employeeId, readAt, createdAt])
  @@index([roleTarget, readAt, createdAt])
}

model ProjectComment {
  id           String    @id @default(cuid())
  projectId    String
  authorUserId String
  message      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       User      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([authorUserId])
}

model Deployment {
  id           String            @id @default(cuid())
  projectId    String
  environment  DeployEnvironment
  status       DeployStatus      @default(PENDING)
  apiCommit    String?
  webCommit    String?
  apiRepoUrl   String?
  webRepoUrl   String?
  server       String?
  deployedById String?
  notes        String?
  deployedAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployedBy   User?             @relation(fields: [deployedById], references: [id])

  @@index([projectId, deployedAt])
  @@index([environment, status])
  @@index([deployedById])
}

model ProjectUpdate {
  id           String       @id @default(cuid())
  legacyId     String?      @unique
  projectId    String
  authorId     String?
  authorName   String
  title        String?
  description  String?
  content      String
  status       String?
  blockers     String?
  nextStep     String?
  hours        Float?
  activityType ActivityType @default(PROJECT)
  createdAt    DateTime     @default(now())
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       Employee?    @relation(fields: [authorId], references: [id])

  @@index([projectId])
}

model WorkLog {
  id           String        @id @default(cuid())
  legacyId     String?       @unique
  employeeId   String
  projectId    String?
  title        String
  description  String
  date         DateTime
  mode         WorkLogMode
  activityType ActivityType  @default(PROJECT)
  hours        Float?
  entryTime    String?
  exitTime     String?
  status       WorkLogStatus @default(SUBMITTED)
  employee     Employee      @relation(fields: [employeeId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([employeeId, date])
  @@index([projectId])
  @@index([activityType])
  @@index([mode])
}

model LicenseRequest {
  id              String          @id @default(cuid())
  legacyId        String?         @unique
  employeeId      String
  articleId       String?
  article         String
  startDate       DateTime
  endDate         DateTime
  reason          String
  certificateName String?
  status          LicenseStatus   @default(PENDING)
  dateRequested   DateTime        @default(now())
  employee        Employee        @relation(fields: [employeeId], references: [id])
  licenseArticle  LicenseArticle? @relation(fields: [articleId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@index([employeeId, status])
  @@index([articleId])
}

model LicenseArticle {
  id              String                @id @default(cuid())
  code            String                @unique
  title           String
  description     String?
  isActive        Boolean               @default(true)
  templatePdfPath String?
  templatePdfName String?
  fields          LicenseArticleField[]
  requests        LicenseRequest[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([isActive])
}

model LicenseArticleField {
  id           String           @id @default(cuid())
  articleId    String
  article      LicenseArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  key          String
  label        String
  type         LicenseFieldType @default(TEXT)
  page         Int              @default(1)
  x            Float
  y            Float
  width        Float?
  height       Float?
  fontSize     Float            @default(10)
  defaultValue String?
  required     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([articleId, key])
  @@index([articleId])
}

model LicenseRule {
  id             String   @id @default(cuid())
  legacyId       String?  @unique
  article        String   @unique
  name           String
  description    String
  maxDaysPerYear Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StrikeConfig {
  id                  String    @id @default("default")
  nextDate            DateTime?
  nextCoverEmployeeId String?
  lastDate            DateTime?
  lastCoverEmployeeId String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model RemoteDay {
  id         String    @id @default(cuid())
  legacyId   String?   @unique
  employeeId String
  day        String
  date       DateTime?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([employeeId, day])
  @@index([employeeId])
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  employeeId String?
  action     String
  module     String    @default("SYSTEM")
  entity     String
  entityType String?
  entityId   String?
  title      String?
  detail     String?
  metadata   Json?
  ip         String?
  userAgent  String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([employeeId])
  @@index([module, action])
  @@index([createdAt])
  @@index([entity, entityId])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  label       String
  description String?
  type        String
  updatedAt   DateTime @updatedAt
}
