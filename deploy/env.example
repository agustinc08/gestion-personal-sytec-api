# Claves que tiene que tener /opt/docker/gestion-personal-sytec-api/.env.<env> (el deploy falla si
# falta alguna o está vacía). Los valores reales sólo viven en la VPS.
NODE_ENV=production
DATABASE_URL=postgresql://gestion_personal_sytec:CAMBIAR@postgres-main:5432/gestion_personal_sytec
# Al menos 32 caracteres; uno distinto por entorno.
JWT_SECRET=CAMBIAR
JWT_EXPIRES_IN=1d
# Origen de la web (sin path), para CORS.
CORS_ORIGIN=https://cncivil05.pjn.gov.ar
